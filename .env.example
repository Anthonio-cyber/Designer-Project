# ---------- Server ----------
NODE_ENV=development
PORT=4000

# Comma separated list of origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173

# Public base URL of the deployed site (used for SEO: sitemap, canonical, OG tags).
PUBLIC_SITE_URL=http://localhost:5173

# ---------- Security ----------
# CHANGE THESE. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# Set to "true" behind HTTPS in production.
COOKIE_SECURE=false

# ---------- Storage ----------
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---------- Bootstrap admin (created on first seed / first boot) ----------
ADMIN_NAME=Amara Studio
ADMIN_EMAIL=admin@designer.studio
ADMIN_PASSWORD=ChangeMe!2024

# ---------- AI (server side only, never exposed to the browser) ----------
# Leave empty to run the assistant in offline/heuristic mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=2000

# =============================================================================
# CONNECTORS — every key below stays on the server. None is ever written to the
# settings table, returned by an API, or exposed to the browser.
# =============================================================================

# ---------- Email (transactional) ----------
# Recommended: Resend. Sign up, verify your sending domain, paste the key here.
# https://resend.com/api-keys
RESEND_API_KEY=

# Alternative: any SMTP server (your host's mailbox, Postmark, SES, Mailgun…).
# Only used when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# With neither configured the app still runs: emails are recorded in the
# email_log table and marked "skipped" instead of being sent.

# ---------- Payments ----------
# Stripe — cards, Apple/Google Pay. Available in ~46 countries.
# https://dashboard.stripe.com/apikeys   (use sk_test_… while developing)
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for POST /api/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=

# Paystack — cards, bank transfer and USSD for Nigeria, Ghana, South Africa,
# Kenya and Egypt, where Stripe cannot pay out. https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=

# Bank transfer needs no key at all: enter the account details in
# Admin -> Settings -> Payments and clients see them on their invoice.
